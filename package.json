{
  "name": "sprint-timer",
  "version": "1.0.0",
  "main": "index.ts",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:cloud": "npx -y firebase-tools@15.37.0 emulators:exec --only auth,firestore --project demo-sprint-timer \"FIREBASE_EMULATOR=1 vitest run --no-file-parallelism test/cloud.test.ts test/records.test.ts test/account.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.26",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "dependencies": {
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-intent-launcher": "~58.0.3",
    "expo-keep-awake": "~58.0.4",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-svg": "^15.16.0",
    "react-native-udp": "^4.1.7",
    "react-native-vision-camera": "^5.2.4",
    "react-native-vision-camera-worklets": "^5.2.4",
    "react-native-worklets": "^0.13.0"
  }
}

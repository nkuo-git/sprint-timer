<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-feature android:name="android.hardware.type.watch" />

  <!-- 和終點手機用區網 UDP 同步；CHANGE_NETWORK_STATE 用來要求系統把 Wi-Fi 打開（手錶平常走藍牙） -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- 口令進行中不讓手錶睡著 -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- App 內更新：下載新版後交給系統安裝；Android 12 以上 App 更新自己可以不用再按確認 -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

  <!-- 用系統的語音合成喊口令 -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:theme="@android:style/Theme.DeviceDefault">

    <!-- 獨立的手錶 App：配對的手機上沒裝 App 也能用（有裝的話，手機可以幫手錶更新） -->
    <meta-data
      android:name="com.google.android.wearable.standalone"
      android:value="true" />

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:taskAffinity=""
      android:theme="@style/AppTheme">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- 手機 App 透過配對連線（藍牙）找手錶：問版本、傳新版安裝檔過來。系統有事才叫起來，手錶 App 不用開著。 -->
    <service
      android:name=".PhoneLinkService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
        <data
          android:scheme="wear"
          android:host="*"
          android:pathPrefix="/sprint-timer" />
      </intent-filter>
    </service>

    <!-- 收系統回報的安裝結果 -->
    <receiver
      android:name=".UpdateReceiver"
      android:exported="false" />
  </application>
</manifest>
